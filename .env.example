# ─── Sistema web Painting Mistery ─────────────────────────────
# Copiar este archivo como .env y completar los valores.
# El .env real nunca se sube al repositorio porque lleva contraseñas.

APP_NAME="Painting Mistery"
# local para desarrollo; production en el servidor
APP_ENV=production
# Se genera con: php artisan key:generate
APP_KEY=
# true solo en desarrollo; en el servidor siempre false
APP_DEBUG=false
APP_URL=https://paintingmistery.dev
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

# Puerto del servidor donde se publica el contenedor de la aplicación (compose.yml)
APP_PORT=8080

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug en desarrollo; error en el servidor
LOG_LEVEL=error

# ─── Base de datos (PostgreSQL) ───────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=painting_mistery
DB_USERNAME=
DB_PASSWORD=

# Ruta a pg_dump/psql si NO están en el PATH (copias de seguridad)
DB_DUMP_PATH=

# ─── Sesiones, caché y colas ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true cuando el sitio funciona con HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Correo (códigos de verificación y recuperación) ──────────
# En desarrollo se puede usar MAIL_MAILER=log para no enviar correos reales.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="paintingmistery20@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Primer administrador (php artisan migrate --seed) ────────
# Si se deja la contraseña vacía, se genera una y se muestra una sola vez.
ADMIN_CORREO=admin@paintingmistery.com
ADMIN_PASSWORD=
